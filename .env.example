# Template only. Never commit populated credentials.
# Local demo: npm run preview:local creates isolated configuration automatically.
APP_URL=https://store.example.com
NEXT_PUBLIC_SITE_URL=https://store.example.com
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_PB_URL=https://data.example.com
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Generate 32 random bytes as 64 hex characters; preserve securely for recovery.
OAUTH_ENCRYPTION_KEY=
CREDENTIALS_FILE=/var/lib/chia-charged/secrets/oauth.enc.json
REDIS_URL=redis://127.0.0.1:6379
# Enable only after ingress replaces IP headers and direct app access is blocked.
TRUST_PROXY_HEADERS=false
# Provisioning input: import into encrypted storage using README step 9.
# The webhook handler does not consume this environment value directly.
STRIPE_WEBHOOK_SECRET=
# Optional admin push
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# PocketBase process variables (configure separately; Next .env does not set these)
CHIA_MAIL_ENABLED=false
CHIA_PUBLIC_APP_URL=https://store.example.com
